# DeepSeek 连接配置。具体模型名称仍是项目 TODO，不在代码中写死。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# WSL 原生 Docker 访问境外云 API 时可配置 Windows 代理；未配置则直接连接。
# Windows 网关可通过 `ip route show default` 查看，代理端口以本机代理软件为准。
OUTBOUND_HTTP_PROXY=
OUTBOUND_HTTPS_PROXY=
# Docker daemon 无法拉取官方基础镜像时，可临时填写已存在的本地 Python 镜像名。
SCRIPT_RUNNER_BASE_IMAGE=python:3.12-slim
OUTBOUND_NO_PROXY=localhost,127.0.0.1,postgres,minio,simulation-db

# 总控 Agent 对非法结构化输出的最大修复次数。
# 一次初始生成 + 最多一次结构化格式修复；不要为同一上下文连续重复模型请求。
CONTROLLER_MAX_REPAIRS=1

# 第二阶段数据库和 Assignment 租约配置。
DATABASE_URL=postgresql+asyncpg://kg_agent:kg_agent@postgres:5432/kg_agent
ASSIGNMENT_LEASE_SECONDS=60
ASSIGNMENT_HEARTBEAT_SECONDS=20
WORKER_POLL_SECONDS=1

# 任务级公开 JSONL 排障日志目录；Docker Compose 会覆盖为容器内 /app/logs。
RUN_LOG_DIR=logs/formal
SIMULATION_RUN_LOG_DIR=logs/simulation
# 测试端可以复用同一个 MinIO 服务，但必须使用与正式端不同的 Bucket。
SIMULATION_MINIO_ENDPOINT=minio:9000
SIMULATION_MINIO_ACCESS_KEY=
SIMULATION_MINIO_SECRET_KEY=
SIMULATION_MINIO_BUCKET=kg-agent-simulation-artifacts
SIMULATION_MINIO_SECURE=false


# 第三阶段对象存储：凭据由部署环境提供，不要把真实密钥提交到仓库。
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=kg-agent-artifacts
MINIO_SECURE=false

# 单个 Artifact 50 MiB、每任务 20 个原始文档、全部 Artifact 总量 500 MiB。
ARTIFACT_MAX_FILE_BYTES=52428800
ARTIFACT_MAX_FILES_PER_TASK=20
ARTIFACT_MAX_TOTAL_BYTES_PER_TASK=524288000

# Mem0 Cloud 长期记忆。未填写 Key 时能力显式禁用，不会降级为本地长期存储。
# API Key 只允许配置在服务端环境，禁止写入前端或提交到仓库。
MEM0_ENABLED=false
MEM0_API_KEY=
MEM0_BASE_URL=https://api.mem0.ai
MEM0_USER_ID=kg-agent-v1-single-user
MEM0_APP_ID=kg-agent-platform-production
MEM0_TOP_K=3
MEM0_CANDIDATE_TOP_K=16
MEM0_THRESHOLD=0.50
MEM0_DEDUP_THRESHOLD=0.92
MEM0_MERGE_THRESHOLD=0.80
MEM0_RERANK=true
MEM0_TIMEOUT_SECONDS=20

# 8002 实验室可复用同一个 Mem0 Key，但必须使用独立 app_id 与 user_id。
# 未设置 SIMULATION_MEM0_API_KEY 时，测试端会复用 MEM0_API_KEY，仅复用凭据、不复用数据空间。
SIMULATION_MEM0_ENABLED=false
SIMULATION_MEM0_API_KEY=
SIMULATION_MEM0_BASE_URL=https://api.mem0.ai
SIMULATION_MEM0_USER_ID=kg-agent-v1-simulation-user
SIMULATION_MEM0_APP_ID=kg-agent-platform-simulation

# 实库测试通过专用 KG_AGENT_TEST_* 环境变量显式启用，不自动使用生产连接。
# KG_AGENT_TEST_MINIO_ENDPOINT=localhost:9000
# KG_AGENT_TEST_MINIO_ACCESS_KEY=
# KG_AGENT_TEST_MINIO_SECRET_KEY=
# KG_AGENT_TEST_MINIO_BUCKET=kg-agent-test-artifacts
# KG_AGENT_TEST_MINIO_SECURE=false
